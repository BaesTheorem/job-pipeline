# Copy to .env (gitignored). Every key is optional; a lane without its key skips itself.
# Floors normally live in profile.yaml; these override them (the tests use them).
# JOB_COMP_FLOOR=
# JOB_ONSITE_FLOOR=

# usajobs.py: free key from https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# moreboards.py jooble: key from https://jooble.org/api/about (500-request default limit)
JOOBLE_API_KEY=
# moreboards.py adzuna: https://developer.adzuna.com/signup (free plan = 25 calls in total;
# the lane counts them and retires itself at the limit)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
